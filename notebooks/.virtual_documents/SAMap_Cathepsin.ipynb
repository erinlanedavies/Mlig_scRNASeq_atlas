        dill.dump(gpf, fh)

    with open(gene_pairs_path, "wb") as fh:
        dill.dump(gene_pairs, fh)
  
    pairs_path = os.path.join(tables_dir, "gene_pairs_thr_0.tsv")
    gene_pairs.to_csv(pairs_path, sep="\t")
    print(f"Gene pairs saved to: {pairs_path}")
    gene_pairs.head(20)

